<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Applied ONLY to the bundled whisper-cli: the Rust core launches it
      with DYLD_LIBRARY_PATH pointing at the ggml dylibs in
      Contents/Frameworks/rust/bin/lib/libinternal. Without this
      entitlement dyld strips DYLD_* variables in Hardened Runtime
      restricted mode and whisper-cli dies with "Library not loaded".
      Notarization-safe.
    -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
