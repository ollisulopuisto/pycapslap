<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hardened Runtime entitlements for the signed release build.
      Notarization accepts both of these; they are the standard set for
      PyInstaller apps that launch helper tools with bundled libraries.

      allow-dyld-environment-variables: the Rust core launches the bundled
      whisper-cli with DYLD_LIBRARY_PATH pointing at the ggml dylibs in
      Contents/Frameworks/rust/bin/lib/libinternal. Without this entitlement
      dyld strips DYLD_* variables in restricted mode and whisper-cli dies
      with "Library not loaded".

      disable-library-validation: the Orukeet worker downloads NVIDIA's
      NeMo-Speech.cpp runtime (libnemo_speech_asr_c.dylib, signed by a
      different team) into ~/Library/Caches and loads it with ctypes.CDLL.
      Default library validation rejects any dylib not signed by Apple or
      this app's team, which kills the worker on startup.
    -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
